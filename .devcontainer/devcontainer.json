{
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "site/index.html"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt",
  "postAttachCommand": {
    "server": "python3 export_site_data.py && python3 -m http.server 8000 --directory site"
  },
  "portsAttributes": {
    "8000": { "label": "Dashboard", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [8000]
}
